#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
[ -f venv/bin/activate ] || { echo "[formmorpheus] backend venv missing, run ./formmorpheus_oc_install" >&2; exit 1; }
source venv/bin/activate
exec uvicorn app.main:app --reload --timeout-graceful-shutdown 3 --host "${FORMMORPHEUS_HOST:-127.0.0.1}" --port "${FORMMORPHEUS_PORT:-9494}"
