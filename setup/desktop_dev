#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
triple="$(rustc -vV 2>/dev/null | awk '/^host:/ {print $2}')"
[ -n "$triple" ] || fm_die "rustc not found; install Rust from https://rustup.rs"
ext=""
[ "$(fm_os)" = windows ] && ext=".exe"
[ -x "$FM_ROOT/frontend/node_modules/.bin/tauri" ] || ( cd "$FM_ROOT/frontend" && npm ci )
if [ -n "${FORMMORPHEUS_DEV_URL:-}" ]; then
  mkdir -p "$FM_ROOT/src-tauri/binaries" "$FM_ROOT/src-tauri/engine"
  stub="$FM_ROOT/src-tauri/binaries/formmorpheus-engine-${triple}${ext}"
  [ -e "$stub" ] || { printf '#!/bin/sh\n' > "$stub"; chmod +x "$stub"; }
elif [ ! -x "$FM_ROOT/src-tauri/binaries/formmorpheus-engine-${triple}${ext}" ] && [ ! -x "$FM_ROOT/src-tauri/engine/formmorpheus-engine" ]; then
  "$FM_ROOT/setup/freeze_backend"
fi
cd "$FM_ROOT"
exec frontend/node_modules/.bin/tauri dev "$@"
