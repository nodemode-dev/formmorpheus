#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FM_ROOT"
pids=()
( cd backend && ./boot_backend ) &
pids+=($!)
( cd frontend && ./boot_frontend ) &
pids+=($!)
trap 'kill "${pids[@]}" 2>/dev/null' EXIT INT TERM
fm_say "frontend http://localhost:5194 · backend http://127.0.0.1:${FORMMORPHEUS_PORT:-9494}"
wait
