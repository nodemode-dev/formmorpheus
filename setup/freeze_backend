#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
plain_framework_libraries() {
  local root link dest fw gone=()
  root="$(cd "$1" && pwd -P)"
  while IFS= read -r link; do
    case "$link" in *.framework/*) continue ;; esac
    dest="$( { cd "$(dirname "$link")" && cd "$(dirname "$(readlink "$link")")" && pwd -P; } 2>/dev/null || true)/$(basename "$(readlink "$link")")"
    case "$dest" in "$root"/*.framework/*) ;; *) continue ;; esac
    file -b "$dest" | grep -Eq 'Mach-O.*(executable|shared library|bundle)' || continue
    cp -p "$dest" "$link.plain"
    rm -f "$link"
    mv "$link.plain" "$link"
    codesign --remove-signature "$link"
    [ -n "${APPLE_SIGNING_IDENTITY:-}" ] || codesign --force --sign - "$link"
    fw="${dest%%.framework/*}.framework"
    gone+=("$fw")
  done < <(find "$root" -type l)
  for fw in ${gone[@]+"${gone[@]}"}; do
    case "$fw" in "$root"/*.framework) rm -rf "$fw" ;; esac
  done
  [ "${#gone[@]}" = 0 ] || fm_say "engine: framework libraries kept as plain files, their framework folders removed: ${#gone[@]}"
}
sign_engine() {
  local ent="$FM_ROOT/src-tauri/entitlements.plist" f info signed=0 kept=0
  local files=() sign_args=() work link
  [ -f "$ent" ] && sign_args+=(--entitlements "$ent")
  plain_framework_libraries "$1"
  work="$(mktemp -d)"
  while IFS= read -r f; do
    if file -b "$f" | grep -Eq 'Mach-O.*(executable|shared library|bundle)'; then files+=("$f"); fi
  done < <(find "$1" -type f | awk -F/ '{print NF "\t" $0}' | sort -rn | cut -f2-)
  for f in "${files[@]}"; do
    info="$(codesign -d --verbose=4 "$f" 2>&1 || true)"
    if printf '%s\n' "$info" | grep -q '^Timestamp=' \
      && printf '%s\n' "$info" | grep -Eq '^CodeDirectory .*flags=[^ ]*runtime' \
      && ! printf '%s\n' "$info" | grep -q '^Signature=adhoc' \
      && [ "${f#*.framework/}" = "$f" ] \
      && { [ "$f" != "$1/formmorpheus-engine" ] || codesign -d --entitlements - "$f" 2>/dev/null | grep -q 'com.apple.security.cs.disable-library-validation'; }; then
      kept=$((kept + 1))
      continue
    fi
    if [ "${f#*.framework/}" = "$f" ]; then
      codesign --force --timestamp --options runtime "${sign_args[@]}" --sign "$APPLE_SIGNING_IDENTITY" "$f"
    else
      cp -p "$f" "$work/${f##*/}"
      codesign --force --timestamp --options runtime "${sign_args[@]}" --sign "$APPLE_SIGNING_IDENTITY" "$work/${f##*/}"
      mv -f "$work/${f##*/}" "$f"
    fi
    signed=$((signed + 1))
  done
  for f in "${files[@]}"; do
    if [ "${f#*.framework/}" = "$f" ]; then
      codesign --verify "$f" || fm_die "engine file failed its signature check: $f"
    else
      codesign --verify --strict "$f" || fm_die "this library sits in a framework folder that nothing links to from outside, and its signature does not hold there; Apple's notary would refuse the app: $f"
    fi
  done
  while IFS= read -r link; do
    file -bL "$link" | grep -Eq 'Mach-O.*(executable|shared library|bundle)' || continue
    cp -L "$link" "$work/${link##*/}"
    codesign --verify --strict "$work/${link##*/}" || fm_die "this engine library loses its signature when it is copied as a plain file, which is how the app bundle carries it: $link"
  done < <(find "$1" -type l)
  rm -rf "$work"
  fm_say "engine signed: ${#files[@]} Mach-O files, $signed signed here, $kept already signed by PyInstaller"
}
fm_venv
python -c "import PyInstaller" 2>/dev/null || fm_die "PyInstaller missing, run ./formmorpheus install-desktop"
if [ -n "${FORMMORPHEUS_TARGET:-}" ]; then
  triple="$FORMMORPHEUS_TARGET"
else
  command -v rustc >/dev/null 2>&1 || fm_die "rustc not found; install Rust or set FORMMORPHEUS_TARGET"
  triple="$(rustc -vV | awk '/^host:/ {print $2}')"
fi
[ -f "$FM_ROOT/frontend/dist/index.html" ] || "$FM_ROOT/setup/build_frontend"
cd "$FM_ROOT/backend"
sep=":"
[ "$(fm_os)" = windows ] && sep=";"
ext=""
[ "$(fm_os)" = windows ] && ext=".exe"
extra=()
[ -z "${FORMMORPHEUS_PYI_ARCH:-}" ] || extra+=(--target-arch "$FORMMORPHEUS_PYI_ARCH")
mode=--onefile
if [ "$(fm_os)" = macos ]; then
  mode=--onedir
  [ -z "${APPLE_SIGNING_IDENTITY:-}" ] || extra+=(--codesign-identity "$APPLE_SIGNING_IDENTITY" --osx-entitlements-file "$FM_ROOT/src-tauri/entitlements.plist")
fi
if [ "$(fm_os)" = windows ]; then
  mode=--onedir
  [ "${FORMMORPHEUS_ENGINE_WINDOWED:-1}" = 0 ] || extra+=(--noconsole)
  extra+=(--collect-all winpty)
fi
src="$(fm_native_path "$FM_ROOT")"
rm -rf build/pyinstaller dist-engine
pyinstaller --noconfirm --clean "$mode" --name formmorpheus-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$src/frontend/dist${sep}frontend_dist" \
  --add-data "$src/backend/app/penlink_static${sep}app/penlink_static" \
  --collect-submodules app --collect-submodules uvicorn --collect-submodules keyring --exclude-module readline \
  "${extra[@]}" \
  "$src/backend/formmorpheus_engine.py"
if [ "$mode" = --onedir ]; then
  out="$FM_ROOT/src-tauri/engine"
  rm -rf "$out"
  cp -R dist-engine/formmorpheus-engine "$out"
  if [ "$(fm_os)" = macos ]; then
    if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then sign_engine "$out"; else plain_framework_libraries "$out"; fi
  fi
  "$out/formmorpheus-engine${ext}" --selfcheck
  fm_say "engine folder ready: $out"
  exit 0
fi
mkdir -p "$FM_ROOT/src-tauri/binaries"
out="$FM_ROOT/src-tauri/binaries/formmorpheus-engine-${triple}${ext}"
cp "dist-engine/formmorpheus-engine${ext}" "$out"
"$out" --selfcheck
fm_say "sidecar ready: $out"
