#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
source setup/lib.sh
usage() {
  printf 'formmorpheus %s · animation studio\n' "$(fm_version)"
  cat << 'EOF2'

usage: ./formmorpheus [command]

  (none) | boot       boot backend (9494) and frontend (5194) together
  install             install backend and frontend
  backend             boot the backend only
  frontend            boot the frontend only
  build               production build of the frontend into frontend/dist
  serve               serve the built frontend from the backend on 127.0.0.1:9494
  freeze              freeze the backend into the desktop engine
  desktop dev|build   run or bundle the desktop app
  doctor              check the toolchain, installs and ports
  version             the version and build
  clean [--all]       remove build output (--all also venv and node_modules)
  help                this text
EOF2
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  backend) cd backend && exec ./boot_backend "$@" ;;
  frontend) cd frontend && exec ./boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  clean) exec setup/clean "$@" ;;
  version|--version|-V)
    printf 'formmorpheus %s' "$(fm_version)"
    commit="$(git rev-parse --short HEAD 2>/dev/null || true)"
    [ -n "$commit" ] && printf ' (%s)' "$commit"
    printf '\n' ;;
  help|-h|--help) usage ;;
  *) printf '[formmorpheus] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
