#!/usr/bin/env bash
set -e
export FORMMORPHEUS_CALLER_DIR="${FORMMORPHEUS_CALLER_DIR:-$PWD}"
cd "$(dirname "$0")"
source setup/lib.sh
usage() {
  printf 'formmorpheus %s · animation studio\n' "$(fm_version)"
  cat << 'EOF2'

usage: ./formmorpheus [command]

  (none) | boot       boot backend (9494) and frontend (5194) together
  install             install backend and frontend
  install-desktop     install the desktop build packages into backend/venv
  backend             boot the backend only
  frontend            boot the frontend only
  build               production build of the frontend into frontend/dist
  serve               serve the built frontend from the backend on 127.0.0.1:9494
  freeze              freeze the backend into the desktop engine
  desktop dev         run the desktop app against the dev servers
  desktop build       build the desktop installers (same as ./build_app)
  ios [--no-open]     build the iPad app project (macOS only): interface, XcodeGen, Xcode
  doctor              check the toolchain, installs and ports
  lint               text lint: no em dash, emoji, attribution trailers or banned names
  test [layer]        run the tests: interface (vitest), engine (pytest), or both when no layer is given
  agents install     set up Claude Code, Codex, Cursor and Antigravity for FormMorpheus (--dry-run shows what)
  agents sync         mirror the skill pack and write agents/manifest.json (--check: exit 1 when stale)
  mcp                 FormMorpheus as an MCP server on standard input and output (for clients that start one)
  version             the version and build
  clean [--all]       remove build output (--all also venv and node_modules)
  help                this text
EOF2
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  backend) cd backend && exec ./boot_backend "$@" ;;
  frontend) cd frontend && exec ./boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec ./build_app "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  ios) exec setup/ios "$@" ;;
  doctor) exec setup/doctor "$@" ;;
  lint) exec python3 setup/lint_text "$@" ;;
  test) exec setup/test "$@" ;;
  agents) exec python3 setup/agents.py "$@" ;;
  mcp) exec python3 setup/mcp_stdio.py "$@" ;;
  clean) exec setup/clean "$@" ;;
  version|--version|-V)
    printf 'formmorpheus %s' "$(fm_version)"
    commit="$(git rev-parse --short HEAD 2>/dev/null || true)"
    [ -n "$commit" ] && printf ' (%s)' "$commit"
    printf '\n' ;;
  help|-h|--help) usage ;;
  *) printf '[formmorpheus] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
