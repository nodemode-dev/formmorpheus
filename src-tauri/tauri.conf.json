{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formmorpheus",
  "version": "0.16.0",
  "identifier": "ai.nodemode.formmorpheus",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formmorpheus",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Animation studio",
    "longDescription": "formmorpheus is an animation studio in the NodeMode design system, with its own .fmo movie files.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formmorpheus-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "priority": "optional",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "recommends": ["xdg-desktop-portal-gtk | xdg-desktop-portal"]
      },
      "rpm": {
        "release": "1",
        "epoch": 0
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null,
      "wix": { "language": "en-US" },
      "nsis": { "languages": ["English"], "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "fileAssociations": [
      { "ext": ["fmo"], "name": "formmorpheus Movie", "description": "formmorpheus animation movie", "role": "Editor", "mimeType": "application/x-formmorpheus" }
    ],
    "createUpdaterArtifacts": false
  }
}
