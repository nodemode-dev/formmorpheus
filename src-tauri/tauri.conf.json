{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormMorpheus",
  "version": "0.38.0",
  "identifier": "ai.nodemode.formmorpheus",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormMorpheus",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Animation studio",
    "longDescription": "FormMorpheus is an animation studio in the Form family, with its own .fmo movie files.",
    "copyright": "Copyright 2026 NodeAgentc, Inc.",
    "publisher": "NodeAgentc, Inc.",
    "externalBin": ["binaries/formmorpheus-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "priority": "optional",
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.46)", "libgtk-3-0"],
        "recommends": ["xdg-desktop-portal-gtk | xdg-desktop-portal", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      },
      "rpm": {
        "release": "1",
        "epoch": 0,
        "depends": ["webkit2gtk4.1 >= 2.46", "gtk3"],
        "recommends": ["gstreamer1-plugins-good", "gstreamer1-plugins-bad-free", "gstreamer1-libav"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null,
      "wix": { "language": "en-US" },
      "nsis": { "languages": ["English"], "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "fileAssociations": [
      { "ext": ["fmo"], "name": "FormMorpheus Movie", "description": "FormMorpheus animation movie", "role": "Editor", "mimeType": "application/x-formmorpheus" }
    ],
    "createUpdaterArtifacts": false
  }
}
