{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The permissions of the main window's page. This file grants them to no remote address: the shell reads the list and grants it at run time to the one origin the window was opened on (allow_page in src/main.rs), the engine's own http://127.0.0.1:<port> or the dev server.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "allow-app-ready",
    "allow-set-window-title",
    "allow-text-edit",
    "allow-take-pending-opens",
    "allow-note-recent-document",
    "allow-reveal-folder"
  ]
}
