{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window shows the page the engine serves on 127.0.0.1, or the Vite dev server on localhost, both remote origins to Tauri, so the capability lists those addresses and every app command has an allow permission from build.rs.",
  "windows": ["splash", "main"],
  "remote": { "urls": ["http://127.0.0.1:*", "http://localhost:5194"] },
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "allow-app-ready",
    "allow-set-window-title",
    "allow-text-edit",
    "allow-take-pending-opens"
  ]
}
