#!/usr/bin/env bash
# Builds the formmorpheus desktop app start to finish: tools, installs, frontend, frozen engine, tauri bundles.
set -euo pipefail
cd "$(dirname "$0")"
source setup/lib.sh

usage() {
  cat <<'EOF'
./build_app            build the formmorpheus desktop app from this folder, start to finish
  --clean              rebuild the Rust side and the frozen engine from nothing
  --bundles a,b        override the bundle list (macOS: app,dmg; Linux: deb,appimage,rpm; Windows: msi,nsis)
  --config X           extra Tauri settings passed on to tauri build, a file path or inline JSON; may be given more than once
Signing is optional: set APPLE_SIGNING_IDENTITY (macOS) or WINDOWS_CERT_THUMBPRINT (Windows) for a signed build;
leave them unset for an unsigned build. CARGO_TARGET_DIR moves the Rust build folder.
Every step's output goes to build_app.log beside this file.
EOF
}

clean=0 bundles=""
configs=()
while [ $# -gt 0 ]; do
  case "$1" in
    --clean) clean=1 ;;
    --bundles) bundles="${2:-}"; shift ;;
    --config)
      [ $# -ge 2 ] && [ -n "$2" ] || { usage >&2; exit 2; }
      configs+=(--config "$2"); shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

log="$FM_ROOT/build_app.log"
: > "$log"
exec > >(tee -a "$log") 2>&1
trap 'status=$?; [ $status -eq 0 ] || printf "\n[formmorpheus] the build stopped (exit %s). The full log is %s\n" "$status" "$log"' EXIT
step() { printf '\n[formmorpheus] == %s\n' "$*"; }

os="$(fm_os)"
step "checking the tools"
[ "$os" = macos ] || [ "$os" = linux ] || fm_die "this script runs on macOS and Linux; on Windows run build_app.bat"
[ "$os" != macos ] || xcode-select -p >/dev/null 2>&1 || fm_die "the Xcode command line tools are missing: run xcode-select --install"
command -v node >/dev/null 2>&1 || fm_die "Node 20.19 or newer is required"
node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)||(a===20&&b>=19)?0:1)' || fm_die "Node $(node -v) is too old; Vite needs 20.19 or 22.12 or newer"
command -v npm >/dev/null 2>&1 || fm_die "npm is missing; it ships with Node"
py="$(fm_python)" || fm_die "Python 3.12 or newer is required"
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
command -v cargo >/dev/null 2>&1 || fm_die "cargo is missing; install Rust from https://rustup.rs and run build_app again"
if [ "$os" = linux ] && command -v pkg-config >/dev/null 2>&1 && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  fm_die "Tauri needs system libraries; on Debian or Ubuntu: sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev librsvg2-dev patchelf"
fi
fm_say "node $(node -v), npm $(npm -v), $("$py" -V), $(rustc -V), $(cargo -V | awk '{print $1, $2}')"

step "installing dependencies"
if [ ! -f backend/venv/bin/activate ] || [ ! -d frontend/node_modules ]; then
  setup/install_all
fi
[ -x frontend/node_modules/.bin/tauri ] || ( cd frontend && npm ci )
tauri_cli="$FM_ROOT/frontend/node_modules/.bin/tauri"
[ -x "$tauri_cli" ] || fm_die "the Tauri command line is missing; run npm ci in frontend (it comes from @tauri-apps/cli)"
fm_say "tauri cli $("$tauri_cli" --version)"
( fm_venv && pip install -q -r backend/requirements_desktop.txt )

if [ "$clean" = 1 ]; then
  step "cleaning earlier builds"
  ( cd src-tauri && cargo clean )
  rm -rf backend/build/pyinstaller backend/dist-engine src-tauri/binaries/formmorpheus-engine-* src-tauri/engine
fi

step "building the frontend"
setup/build_frontend
step "freezing the engine into the app's sidecar"
setup/freeze_backend

version="$("$py" -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' src-tauri/tauri.conf.json)"
args=(build)
cfg=""
case "$os" in
  macos)
    : "${bundles:=app,dmg}"
    if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
      cfg='{"bundle":{"macOS":{"signingIdentity":"'"$APPLE_SIGNING_IDENTITY"'"}}}'
      fm_say "signing with APPLE_SIGNING_IDENTITY"
    else
      cfg='{"bundle":{"macOS":{"signingIdentity":"-"}}}'
      fm_say "no APPLE_SIGNING_IDENTITY: ad-hoc signed build, macOS may ask once before it opens"
    fi ;;
  linux)
    if [ -z "$bundles" ]; then
      bundles="deb,appimage"
      command -v rpmbuild >/dev/null 2>&1 && bundles="$bundles,rpm" || fm_say "rpmbuild not found: skipping the rpm bundle"
    fi ;;
esac
args+=(--bundles "$bundles")
[ -z "$cfg" ] || args+=(--config "$cfg")
args+=(${configs[@]+"${configs[@]}"})

step "building the desktop app (the first build compiles several hundred Rust crates)"
cd "$FM_ROOT/src-tauri"
# AppImage tools need FUSE; extract-and-run avoids it on build machines without it.
export APPIMAGE_EXTRACT_AND_RUN="${APPIMAGE_EXTRACT_AND_RUN:-1}"
export NO_STRIP="${NO_STRIP:-1}"
"$tauri_cli" "${args[@]}"

target="${CARGO_TARGET_DIR:-$FM_ROOT/src-tauri/target}"
bundle="$target/release/bundle"
step "done in ${SECONDS}s: formmorpheus $version"
fm_say "bundles are in $bundle"
find "$bundle" -maxdepth 2 -type f \( -name '*.deb' -o -name '*.AppImage' -o -name '*.rpm' -o -name '*.dmg' \) 2>/dev/null | sed 's/^/  /' || true
find "$bundle/macos" -maxdepth 1 -type d -name '*.app' 2>/dev/null | sed 's/^/  /' || true
exit 0
