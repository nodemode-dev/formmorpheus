// Copy this file to Local.xcconfig (same folder) and fill in your values.
// Local.xcconfig is gitignored. Find your Team ID in Xcode under Settings > Accounts,
// or at developer.apple.com under Membership details (ten characters, letters and digits).

DEVELOPMENT_TEAM = ABCDE12345

// Only needed if ai.nodemode.formmorpheus is not available to your account:
// PRODUCT_BUNDLE_IDENTIFIER = com.example.formmorpheus

// A personal (free) team cannot sign the iCloud entitlement. To build without iCloud Drive
// (the library then stays on the iPad), clear the entitlements file:
// CODE_SIGN_ENTITLEMENTS =
