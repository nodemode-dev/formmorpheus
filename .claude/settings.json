{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(./formmorpheus:*)",
      "Bash(./build_app:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  }
}
